# Variables de Plane para EasyPanel (pestaña "Environment" del servicio).
# 1) Pon tu subdominio en APP_DOMAIN (sin https://).
# 2) Rellena cada secreto con un valor aleatorio distinto, SOLO letras y números
#    (van dentro de URLs de conexión). Generarlos en el servidor con:
#       for v in POSTGRES_PASSWORD RABBITMQ_PASSWORD AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY SECRET_KEY LIVE_SERVER_SECRET_KEY; do echo "$v=$(openssl rand -hex 24)"; done
# 3) No cambies POSTGRES_PASSWORD ni RABBITMQ_PASSWORD despues del primer despliegue:
#    quedan grabadas en los volumenes de datos.

APP_DOMAIN=plane.tudominio.com

POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# Opcionales
# Tamaño maximo de adjunto en bytes (5 MB por defecto)
FILE_SIZE_LIMIT=5242880
# Solo si pones Cloudflare u otro proxy delante de EasyPanel: añade sus rangos de IP
TRUSTED_PROXIES=private_ranges
# Destinos de webhooks en red privada permitidos (por defecto ninguno, proteccion SSRF)
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOWED_IPS=
# Peticiones por minuto de cada token de la API (Power BI, scripts). Subelo a 300/minute si un informe da error 429
API_KEY_RATE_LIMIT=60/minute
# Procesos de la API de Plane: 2 con 8 GB de RAM o mas
GUNICORN_WORKERS=1
